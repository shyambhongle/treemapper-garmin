<?xml version="1.0"?>
<!--
  TreeMapper GPS for Garmin.

  Two permissions, no more. Every permission is shown to the user in the store
  before install and costs conversion, so the app asks for exactly what it uses:

    Positioning     Toybox.Position. enableLocationEvents() is limited to
                    device apps and widgets, which is why this app is a
                    watch-app and why a background service cannot do this work.
    Communications  Toybox.Communications, for the Bluetooth link to the
                    TreeMapper phone app.

  No Background permission: everything happens in the foreground while the app
  is open. No Fit permission: the app does not record activities, and holding
  Fit would move it into the device's Activities list instead of the app list.

  minApiLevel 3.3.6 is set by the multi band GNSS configuration constants
  (CONFIGURATION_GPS_GLONASS_GALILEO_BEIDOU_L1_L5 and hasConfigurationSupport),
  which are the whole reason for using a watch over a phone.

  Set the real product list with "Monkey C: Edit Products" so the ids are
  validated against your SDK.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="a7f3c81e6b2d4f9ea05c73819d4e6b21"
        type="watch-app"
        name="@Strings.AppName"
        entry="TreeMapperApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.6">

        <iq:products>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="epix2"/>
            <iq:product id="venu3"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="instinct2x"/>
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
