<?xml version="1.0"?>
<!--
  TreeMapper GPS for Garmin - UI prototype.

  NOTE: this build is UI only. No Positioning or Communications permission is
  declared because nothing talks to the GNSS receiver or the phone yet. When the
  real functionality lands, add:

      <iq:uses-permission id="Positioning"/>
      <iq:uses-permission id="Communications"/>

  and raise minApiLevel to 3.3.6 for the multi-band GNSS configuration constants.

  The product list below is a starting set. Set the real list with the VS Code
  command "Monkey C: Edit Products" so the ids are validated against your SDK.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="a7f3c81e6b2d4f9ea05c73819d4e6b21"
        type="watch-app"
        name="@Strings.AppName"
        entry="TreeMapperApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <iq:products>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fenix843mm"/>
            <iq:product id="fenix847mm"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="epix2"/>
            <iq:product id="venu3"/>
            <iq:product id="vivoactive5"/>
            <iq:product id="instinct2x"/>
        </iq:products>

        <iq:permissions/>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
